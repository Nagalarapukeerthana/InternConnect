# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# SESSION_SECRET: Cryptographic secret for signing session tokens and cookies (min 32 chars)
SESSION_SECRET="internconnect_super_secure_production_secret_key_change_me"

# FIREBASE CONFIGURATION (Server-side Firebase Admin SDK)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# RAZORPAY PAYMENT GATEWAY (Server-side only)
# Obtain these from Razorpay Dashboard -> Settings -> API Keys (Test or Live)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# SERVER-SIDE EMAIL SERVICE (SMTP or SendGrid)
# Real SMTP server credentials for OTPs, invoices, and password resets
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_email_service_api_key_or_password"
SMTP_FROM="InternConnect <support@internconnect.com>"

# In local development where SMTP is not yet set up, set to 'preview' to log OTPs to server console
EMAIL_MODE="preview"

# COMMUNITY POSTING POLICY
# Configurable daily posting limit for users with 3 to 10 accepted friends (default: 1)
POST_LIMIT_3_TO_10_FRIENDS=1
